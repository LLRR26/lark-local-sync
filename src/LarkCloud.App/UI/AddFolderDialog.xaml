<Window x:Class="LarkCloud.App.UI.AddFolderDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LarkCloud.App.UI"
        Style="{StaticResource AppWindow}" Title="Add a folder" Width="760" Height="720" MinWidth="620" MinHeight="600"
        ShowInTaskbar="True" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- step indicator -->
        <Grid Margin="32,24,32,8" x:Name="Steps">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" x:Name="StepBox1">
                <Border x:Name="Dot1" Width="24" Height="24" CornerRadius="12" BorderThickness="1"><TextBlock x:Name="Num1" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="Lbl1" Text="Lark folder" Style="{StaticResource BodyText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="12,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="StepBox2">
                <Border x:Name="Dot2" Width="24" Height="24" CornerRadius="12" BorderThickness="1"><TextBlock x:Name="Num2" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="Lbl2" Text="Place on this PC" Style="{StaticResource BodyText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="3" Height="1" Background="{DynamicResource DividerBrush}" Margin="12,0"/>
            <StackPanel Grid.Column="4" Orientation="Horizontal" x:Name="StepBox3">
                <Border x:Name="Dot3" Width="24" Height="24" CornerRadius="12" BorderThickness="1"><TextBlock x:Name="Num3" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock x:Name="Lbl3" Text="Confirm" Style="{StaticResource BodyText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="32,8,32,0">
            <!-- ============================================ step 1 -->
            <Grid x:Name="Step1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="Head1" Text="Choose a Lark folder" Style="{StaticResource SubtitleText}" Focusable="True"/>
                    <TextBlock Text="Its files will show on this PC and download only when you open them." Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton x:Name="ModeBrowse" Style="{StaticResource Segment}" Content="My folders and wikis" IsChecked="True" GroupName="mode" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeShared" Style="{StaticResource Segment}" Content="Shared with me" GroupName="mode" Checked="Mode_Checked"/>
                    <RadioButton x:Name="ModeLink" Style="{StaticResource Segment}" Content="Paste a link" GroupName="mode" Checked="Mode_Checked"/>
                </StackPanel>

                <!-- what the current source asks for -->
                <Grid Grid.Row="2" Margin="0,8,0,8" MinHeight="36">
                    <Grid x:Name="BrowseRow">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Open a folder, then select the one you want." Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center"/>
                        <Button x:Name="NewFolderButton" Grid.Column="1" Click="NewFolder_Click" Content="New folder in Lark…"/>
                    </Grid>
                    <Grid x:Name="SharedRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Find a folder shared with you" PreviewKeyDown="SearchBox_KeyDown" TextChanged="Hint_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Find a folder shared with you" Style="{StaticResource BodySecondaryText}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Click="Search_Click"/>
                    </Grid>
                    <Grid x:Name="LinkRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LinkBox" AutomationProperties.Name="Lark folder link" PreviewKeyDown="LinkBox_KeyDown" TextChanged="Hint_TextChanged"/>
                        <TextBlock x:Name="LinkHint" Text="Paste a Lark folder link" Style="{StaticResource BodySecondaryText}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Use link" Margin="8,0,0,0" Click="UseLink_Click"/>
                    </Grid>
                </Grid>

                <!-- inline "new folder" prompt -->
                <Border x:Name="NewFolderBar" Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="12" Visibility="Collapsed" Panel.ZIndex="2" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="NewFolderPrompt" Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                            <TextBox x:Name="NewFolderName" AutomationProperties.Name="Name of the new folder" PreviewKeyDown="NewFolderName_KeyDown"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Create" Style="{StaticResource AccentButton}" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="CreateFolder_Click"/>
                        <Button Grid.Column="2" Content="Cancel" VerticalAlignment="Bottom" Margin="8,0,0,0" Click="CancelNewFolder_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <TreeView x:Name="Tree" AutomationProperties.Name="Lark folders" SelectedItemChanged="Tree_SelectedItemChanged"/>
                        <StackPanel x:Name="TreeBusy" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <ui:Spinner Margin="0,0,12,0"/>
                            <TextBlock x:Name="TreeBusyText" Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TreeEmpty" Style="{StaticResource BodySecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Border x:Name="LoadError" Grid.Row="4" Style="{StaticResource InfoBar}" Background="{DynamicResource CriticalBgBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" Foreground="{DynamicResource CriticalBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LoadErrorText" Style="{StaticResource BodyText}"/>
                            <TextBlock x:Name="LoadErrorIt" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="LoadRetry" Grid.Column="2" Content="Try again" Margin="12,0,0,0" Click="LoadRetry_Click"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite">
                    <TextBlock x:Name="PickedIcon" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="Picked" Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- ============================================ step 2 -->
            <StackPanel x:Name="Step2" Visibility="Collapsed">
                <TextBlock x:Name="Head2" Text="Where should it appear on this PC?" Style="{StaticResource SubtitleText}" Focusable="True"/>
                <TextBlock x:Name="Step2Intro" Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0"/>
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PcBox" AutomationProperties.Name="Folder on this PC" TextChanged="PcBox_TextChanged"/>
                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>
                <Border x:Name="PcNote" Style="{StaticResource InfoBar}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PcNoteIcon" Style="{StaticResource IconText}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                        <TextBlock x:Name="PcNoteText" Grid.Column="1" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============================================ step 3 -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock x:Name="Head3" Text="Ready to add this folder" Style="{StaticResource SubtitleText}" Focusable="True"/>
                <TextBlock Text="Check that this is what you want." Style="{StaticResource BodySecondaryText}" Margin="0,4,0,0"/>
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="In Lark" Style="{StaticResource BodySecondaryText}" Width="96" VerticalAlignment="Top"/>
                        <TextBlock x:Name="SumLark" Grid.Column="1" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="On this PC" Style="{StaticResource BodySecondaryText}" Width="96" Margin="0,12,0,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="SumPc" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </Grid>
                </Border>
                <TextBlock Text="After you add it, the folder opens in File Explorer. Files download when you open them." Style="{StaticResource BodySecondaryText}" Margin="0,12,0,0"/>
                <Border x:Name="SumNote" Style="{StaticResource InfoBar}" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SumNoteIcon" Style="{StaticResource IconText}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                        <StackPanel Grid.Column="1" x:Name="SumNotes"/>
                    </Grid>
                </Border>
                <Border x:Name="AddError" Style="{StaticResource InfoBar}" Background="{DynamicResource CriticalBgBrush}" BorderBrush="{DynamicResource CardStrokeBrush}"
                        Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" Foreground="{DynamicResource CriticalBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                        <TextBlock x:Name="AddErrorText" Grid.Column="1" Style="{StaticResource BodyText}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                    <ui:Spinner x:Name="FootBusy" Width="16" Height="16" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="FootText" Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BackButton" Content="Back" MinWidth="96" Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
                    <Button x:Name="NextButton" Content="Next" MinWidth="96" Style="{StaticResource AccentButton}" IsDefault="True" Margin="0,0,8,0" Click="Next_Click" IsEnabled="False"/>
                    <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
