<Window x:Class="LarkCloud.App.UI.CheckDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LarkCloud.App.UI"
        Style="{StaticResource AppWindow}" Title="Check Lark features" Width="700" Height="660" MinWidth="560" MinHeight="480"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,16">
            <TextBlock Text="Check Lark features" Style="{StaticResource SubtitleText}"/>
            <TextBlock Style="{StaticResource BodySecondaryText}" Margin="0,8,0,0"
                       Text="Tests each feature with your Lark account, in a temporary folder “Lark Cloud check (safe to delete)” in My Folders that is removed afterwards. Takes about a minute."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,0">
            <Grid>
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="Results" Margin="8" Focusable="False" AutomationProperties.Name="Results of the check">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:CheckVm}">
                                <Grid Margin="12,10" AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" Foreground="{Binding Brush}" FontSize="18" Width="28"
                                               VerticalAlignment="Top" Margin="0,1,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}"/>
                                            <TextBlock Text="{Binding Words}" Style="{StaticResource CaptionText}" Foreground="{Binding Brush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource BodySecondaryText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Fix}" Visibility="{Binding FixVisibility}" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ForIt}" Visibility="{Binding ForItVisibility}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="NotRun" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="0,0,0,24">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" FontSize="40" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Not checked yet" Style="{StaticResource BodyStrongText}" TextAlignment="Center"/>
                    <TextBlock Text="Press “Run the check”. Each feature gets a result here, with what to ask your IT team for if something is missing."
                               Style="{StaticResource BodySecondaryText}" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite">
                    <ui:Spinner x:Name="Busy" Width="16" Height="16" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusIcon" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,8,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource BodyText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyButton" Content="Copy results" Margin="16,0,8,0" IsEnabled="False" Click="Copy_Click"
                            ToolTip="Copy the results to send to your IT team"/>
                    <Button x:Name="RunButton" Content="Run the check" Style="{StaticResource AccentButton}" IsDefault="True" Margin="0,0,8,0" Click="Run_Click"/>
                    <Button Content="Close" MinWidth="96" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
