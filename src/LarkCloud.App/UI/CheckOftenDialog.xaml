<Window x:Class="LarkCloud.App.UI.CheckOftenDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Check often" Width="520" Height="440" MinWidth="440" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,12">
            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleText}"/>
            <TextBlock Text="Changes made in Lark to these folders, and the folders inside them, show up here within about half a minute. Everything else is checked every few minutes."
                       Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,0">
            <Grid>
                <ListBox x:Name="List" Style="{StaticResource PlainList}" Margin="4" AutomationProperties.Name="Folders checked often"
                         SelectionChanged="List_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListItem}"/>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" ToolTip="{Binding}" Style="{StaticResource BodyText}" Margin="12,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="Empty" Text="No folders yet. Choose Add to pick one." Style="{StaticResource BodySecondaryText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Add…" MinWidth="96" Margin="0,0,8,0" Click="Add_Click"/>
                    <Button x:Name="RemoveButton" Content="Remove" MinWidth="96" IsEnabled="False" Click="Remove_Click"/>
                </StackPanel>
                <Button Content="Done" Style="{StaticResource AccentButton}" MinWidth="96" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
