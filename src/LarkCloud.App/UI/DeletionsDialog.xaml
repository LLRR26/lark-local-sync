<Window x:Class="LarkCloud.App.UI.DeletionsDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" Title="Review deletions" Width="680" Height="620" MinWidth="560" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,12">
            <TextBlock x:Name="Heading" Style="{StaticResource SubtitleText}"/>
            <TextBlock x:Name="FolderLine" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
            <TextBlock Text="This many deletions at once is held back in case it was a mistake. Nothing is deleted until you choose."
                       Style="{StaticResource BodyText}" Margin="0,12,0,0"/>
            <StackPanel x:Name="Effects" Margin="0,16,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="32,0,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="SearchRow" Margin="0,0,0,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="Search" AutomationProperties.Name="Search the list" TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="Search the list" Style="{StaticResource BodySecondaryText}" IsHitTestVisible="False"
                           Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="Shown" Grid.Column="1" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <ListBox x:Name="List" Style="{StaticResource PlainList}" Margin="4" AutomationProperties.Name="Items waiting to be deleted">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainListItem}"/>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="12,12,12,4">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0:N0}'}" Style="{StaticResource BodySecondaryText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource BodyText}" Margin="12,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoMatch" Text="Nothing in the list matches that." Style="{StaticResource BodySecondaryText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeleteButton" Style="{StaticResource CriticalButton}" Margin="0,0,8,0" Click="Delete_Click"/>
                <Button x:Name="RestoreButton" Content="Put them back" IsDefault="True" Margin="0,0,8,0" Click="Restore_Click"/>
                <Button Content="Decide later" MinWidth="96" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
