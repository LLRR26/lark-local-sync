<UserControl x:Class="LarkCloud.App.UI.FoldersPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LarkCloud.App.UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Folders" Style="{StaticResource BodyStrongText}"/>
                <TextBlock x:Name="Intro" Style="{StaticResource CaptionText}" Margin="0,2,16,0"/>
            </StackPanel>
            <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Add a folder" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ListBox x:Name="List" Grid.Row="1" Style="{StaticResource CardList}" ItemContainerStyle="{StaticResource CardListItem}"
                 AutomationProperties.Name="Lark folders on this PC" SelectionMode="Single"
                 PreviewKeyDown="List_PreviewKeyDown" MouseDoubleClick="List_DoubleClick"
                 PreviewMouseRightButtonDown="List_RightClick" ContextMenuOpening="List_ContextMenuOpening">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:FolderRow}">
                    <Grid Margin="16,12,12,12" AutomationProperties.Name="{Binding Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" FontSize="24" Width="32" Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,6,0"
                                           ui:Motion.Spin="{Binding IsBusy}"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Open folder" Margin="16,0,8,0" VerticalAlignment="Center" IsTabStop="False" Click="OpenFolder_Click"
                                AutomationProperties.Name="{Binding OpenLabel}"/>
                        <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource IconButton}" VerticalAlignment="Center" IsTabStop="False" Click="More_Click"
                                AutomationProperties.Name="{Binding MoreLabel}" ToolTip="More actions">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE712;"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="0,0,12,48" Visibility="Collapsed">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" FontSize="48" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
            <TextBlock Text="No Lark folders on this PC yet" Style="{StaticResource SubtitleText}" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="EmptyText" Style="{StaticResource BodySecondaryText}" TextAlignment="Center" Margin="0,0,0,20"/>
            <Button x:Name="EmptyAdd" Content="Add a folder" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
