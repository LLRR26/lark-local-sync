<UserControl x:Class="LarkCloud.App.UI.ProblemsPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LarkCloud.App.UI">
    <UserControl.Resources>
        <!-- headers ("Folder name", "Good to know") are plain text, not selectable; notes are quiet rows without a card -->
        <ControlTemplate x:Key="HeaderItemTemplate" TargetType="ListBoxItem">
            <ContentPresenter/>
        </ControlTemplate>
        <ControlTemplate x:Key="QuietItemTemplate" TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,0,0" SnapsToDevicePixels="True">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleHoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="ProblemItem" TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Header">
                    <Setter Property="Template" Value="{StaticResource HeaderItemTemplate}"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Note">
                    <Setter Property="Template" Value="{StaticResource QuietItemTemplate}"/>
                    <Setter Property="Margin" Value="0,0,12,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type ui:ProblemHeader}">
            <Grid Margin="4,16,12,8" AutomationProperties.Name="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="16" Width="24" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{Binding TitleBrush}"/>
                    <TextBlock Text="{Binding Count}" Style="{StaticResource BodySecondaryText}" TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ProblemRow}">
            <Grid Margin="16,12,12,12" AutomationProperties.Name="{Binding AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Rel}" Style="{StaticResource BodyStrongText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               FontWeight="{Binding NameWeight}"/>
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource BodySecondaryText}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Where}" Visibility="{Binding WhereVisibility}" ToolTip="{Binding Where}" Style="{StaticResource CaptionText}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="{Binding Label1}" Visibility="{Binding Vis1}" IsTabStop="False" Margin="0,0,8,0" Click="A1_Click"
                            AutomationProperties.Name="{Binding Automation1}"/>
                    <Button Content="{Binding Label2}" Visibility="{Binding Vis2}" IsTabStop="False" Margin="0,0,8,0" Click="A2_Click"
                            AutomationProperties.Name="{Binding Automation2}"/>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" IsTabStop="False" Click="More_Click"
                            AutomationProperties.Name="{Binding MoreLabel}" ToolTip="More actions">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE712;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,8,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Files that can't sync" Style="{StaticResource BodyStrongText}"/>
                <TextBlock x:Name="Intro" Style="{StaticResource CaptionText}" Margin="0,2,16,0"/>
            </StackPanel>
            <StackPanel x:Name="FilterBox" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Show" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="Filter" MinWidth="220" SelectionChanged="Filter_Changed" AutomationProperties.Name="Show files from">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Retrying" Grid.Row="1" Orientation="Horizontal" Margin="4,0,12,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
            <ui:Spinner Width="16" Height="16" Margin="0,0,12,0"/>
            <TextBlock Text="Trying again… this list updates when the check finishes." Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource ProblemItem}"
                 AutomationProperties.Name="Files that can't sync" SelectionMode="Single"
                 PreviewKeyDown="List_PreviewKeyDown" MouseDoubleClick="List_DoubleClick"
                 PreviewMouseRightButtonDown="List_RightClick" ContextMenuOpening="List_ContextMenuOpening"/>

        <StackPanel x:Name="Empty" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="0,0,12,48" Visibility="Collapsed">
            <TextBlock x:Name="EmptyGlyph" Style="{StaticResource IconText}" Text="&#xE930;" FontSize="48" Margin="0,0,0,16"/>
            <TextBlock x:Name="EmptyTitle" Text="All files are syncing" Style="{StaticResource SubtitleText}" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="EmptyText" Style="{StaticResource BodySecondaryText}" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
