<UserControl x:Class="LarkCloud.App.UI.SettingsPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,16,12,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,24"/>
            <StackPanel x:Name="Rows"/>
            <Expander x:Name="AdvancedExpander" Margin="0,16,0,0">
                <Expander.Header>
                    <StackPanel>
                        <TextBlock Text="Advanced" Style="{StaticResource BodyText}"/>
                        <TextBlock Text="Deleting, speed and files to leave out. The defaults are right for most people." Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel x:Name="AdvancedRows"/>
            </Expander>
            <TextBlock x:Name="About" Style="{StaticResource CaptionText}" Margin="0,24,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
