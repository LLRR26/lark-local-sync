<Window x:Class="LarkCloud.App.UI.SignInDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LarkCloud.App.UI"
        Style="{StaticResource AppWindow}" Title="Sign in" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="32,28,32,24">
            <TextBlock Text="Sign in to Lark" Style="{StaticResource SubtitleText}"/>
            <TextBlock Text="Sign in with your own Lark account in your browser, and check that the page shows this code."
                       Style="{StaticResource BodySecondaryText}" Margin="0,8,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16" MinHeight="88">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Code" Style="{StaticResource TitleText}" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="…"/>
                    <Button x:Name="Copy" Grid.Column="1" Click="Copy_Click" VerticalAlignment="Center" Margin="16,0,0,0" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CopyGlyph" Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CopyText" Text="Copy code" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- what is happening right now -->
            <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite">
                <ui:Spinner x:Name="Busy" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusIcon" Style="{StaticResource IconText}" FontSize="16" Margin="0,0,12,0" Visibility="Collapsed"/>
                <TextBlock x:Name="Status" Style="{StaticResource BodySecondaryText}" VerticalAlignment="Center" Text="Contacting Lark…"/>
            </StackPanel>

            <Border x:Name="ErrorBar" Style="{StaticResource InfoBar}" Background="{DynamicResource CriticalBgBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" Foreground="{DynamicResource CriticalBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Signing in didn't work" Style="{StaticResource BodyStrongText}"/>
                        <TextBlock x:Name="ErrorText" Style="{StaticResource BodyText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Open" Content="Open Lark sign-in page" Style="{StaticResource AccentButton}" IsDefault="True" IsEnabled="False" Margin="0,0,8,0" Click="Open_Click"/>
                <Button x:Name="Retry" Content="Try again" Style="{StaticResource AccentButton}" Visibility="Collapsed" Margin="0,0,8,0" Click="Retry_Click"/>
                <Button x:Name="Cancel" Content="Cancel" MinWidth="96" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
