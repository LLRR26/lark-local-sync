<UserControl x:Class="LarkCloud.App.UI.Spinner" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:LarkCloud.App.UI"
             Width="20" Height="20" Focusable="False" IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <!-- turns only while shown and while Windows animation effects are on (Motion.Spin); otherwise a still ring -->
        <Grid Width="20" Height="20" ui:Motion.Spin="True">
            <Ellipse Width="16" Height="16" Stroke="{DynamicResource DividerBrush}" StrokeThickness="2.5"/>
            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 10,2 A 8,8 0 0 1 18,10"/>
        </Grid>
    </Viewbox>
</UserControl>
